NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pepsa_vendor
CORS_ORIGINS=http://localhost:5173
AUTH_ISSUER=pepsa-vendor
AUTH_AUDIENCE=pepsa-vendor-api
# PEM values are required in production. Preserve line breaks or encode them as \\n.
AUTH_PRIVATE_KEY_PEM=
AUTH_PUBLIC_KEY_PEM=
KYC_ENCRYPTION_KEY_BASE64=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=pepsa-vendor-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
ADMIN_CONTROL_PLANE_ISSUER=pepsa-admin
ADMIN_CONTROL_PLANE_AUDIENCE=pepsa-vendor-admin
ADMIN_CONTROL_PLANE_SIGNING_SECRET=
ADMIN_CONTROL_PLANE_PUBLIC_KEY_PEM=
ADMIN_VENDOR_SIGNING_KEY_ID=admin-vendor-local-v1
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pepsa Vendor <no-reply@pepsa.co>
FRONTEND_URL=http://localhost:5173
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_MS=5000
# Development/test use deterministic local geocoding when the key is empty.
# Production always requires a real Google Maps key and fails closed.
PEPSA_PAYMENT_URL=http://localhost:3200/v1
PEPSA_PAYMENT_API_KEY=
PEPSA_PAYMENT_TIMEOUT_MS=5000
ACCOUNT_RECONCILIATION_INTERVAL_MS=60000
CHECKOUT_RECONCILIATION_INTERVAL_MS=60000
PEPSA_PAYMENT_WEBHOOK_SECRET=
PEPSA_PAYMENT_PLATFORM_ID=
# Key ID must match the Pepsa Payment subscription for this deploy lane.
PEPSA_PAYMENT_EVENT_KEY_ID=vendor-local
PAYMENT_VENDOR_SIGNING_KEY_ID=vendor-payment-local-v1
PEPSA_ORDER_URL=http://localhost:3300
PEPSA_ORDER_API_ID=
PEPSA_ORDER_SUB_ID=
PEPSA_ORDER_SECURITY_TOKEN=
PEPSA_ORDER_COST_TYPE=VENDOR_PREPAID
PEPSA_ORDER_TIMEOUT_MS=5000
VENDOR_ORDER_SIGNING_KEY_ID=vendor-order-local-v1
ORDER_VENDOR_SIGNING_KEY_ID=order-vendor-local-v1
SWAGGER_ENABLED=true
# M5 local dispatch adapters are deterministic. Configure the signed provider
# webhook secret before connecting a production dispatch provider.
DISPATCH_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
DISPATCH_WEBHOOK_KEY_ID=dispatch-vendor-local-v1
